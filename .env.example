DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# Необязательно. Токен Hugging Face (https://huggingface.co/settings/tokens):
# если модели уже лежат в hf_cache/, приложение само включает офлайн-режим,
# и предупреждение об неаутентифицированных запросах не появляется.
# Токен нужен только если хочешь аутентифицированные запросы к HF Hub
# (выше лимиты, быстрее докачка моделей на новой машине).
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
